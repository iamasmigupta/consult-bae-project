{
  "name": "ConsultBae - Duplicate Contact Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "consultbae-new-contacts",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "consultbae-new-contacts"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/api/dedup/check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contacts: $json.body.contacts || [$json.body] } }}",
        "options": {}
      },
      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Call dedup API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3333333-3333-3333-3333-333333333333",
      "name": "Duplicates found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-1",
              "name": "status",
              "value": "duplicate_detected",
              "type": "string"
            },
            {
              "id": "assign-2",
              "name": "alert_message",
              "value": "=\ud83d\udea8 {{ $json.count }} duplicate contact(s) detected in ConsultBae DB",
              "type": "string"
            },
            {
              "id": "assign-3",
              "name": "count",
              "value": "={{ $json.count }}",
              "type": "number"
            },
            {
              "id": "assign-4",
              "name": "duplicates",
              "value": "={{ $json.duplicates }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "d4444444-4444-4444-4444-444444444444",
      "name": "Build alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "e5555555-5555-5555-5555-555555555555",
      "name": "Respond - alert",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', message: 'no duplicates found' } }}",
        "options": {}
      },
      "id": "f6666666-6666-6666-6666-666666666666",
      "name": "Respond - clean",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        400
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call dedup API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call dedup API": {
      "main": [
        [
          {
            "node": "Duplicates found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Duplicates found?": {
      "main": [
        [
          {
            "node": "Build alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond - clean",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build alert": {
      "main": [
        [
          {
            "node": "Respond - alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}